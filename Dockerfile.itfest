FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine AS build

WORKDIR /src

RUN apk add --no-cache nodejs npm python3 make g++ git

COPY . .

WORKDIR /src/src/GZCTF/ClientApp

RUN npm install -g pnpm
ENV CI=true
RUN pnpm install --frozen-lockfile
RUN pnpm build

WORKDIR /src/src/GZCTF

RUN dotnet restore
RUN dotnet publish GZCTF.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS final

WORKDIR /app

RUN apk add --no-cache icu-libs tzdata curl krb5-libs \
    && adduser -D -u 1000 appuser

ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false
ENV ASPNETCORE_URLS=http://+:8080

COPY --from=build /app/publish .

USER appuser

EXPOSE 8080

ENTRYPOINT ["dotnet", "GZCTF.dll"]
